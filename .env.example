# 数据源配置
DS_TYPE=mock
DS_HOST=localhost
DS_PORT=3306
DS_DATABASE=prudence
DS_USER=root
DS_PASSWORD=
DS_DB_PATH=./prudence.db

# 意图模型
INTENT_MODEL_PATH=./intent_model.pkl
INTENT_STAGE=stable
INTENT_THRESHOLD_HIGH=0.7
INTENT_THRESHOLD_LOW=0.4

# 特征存储（Redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ENABLE=False

# API 服务
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs