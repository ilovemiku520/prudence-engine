# 数据源配置
DS_TYPE=mock
DS_HOST=localhost
DS_PORT=3306
DS_DATABASE=prudence
DS_USER=root
DS_PASSWORD=
DS_DB_PATH=./prudence.db

# 意图模型
INTENT_MODEL_PATH=./intent_model.pkl
INTENT_STAGE=stable
INTENT_THRESHOLD_HIGH=0.7
INTENT_THRESHOLD_LOW=0.4

# 特征存储（Redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ENABLE=False

# API 服务
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# 管理接口（客户详情、审计、指标）必须配置强随机令牌后才会开放
PRUDENCE_ADMIN_TOKEN=

# 审计日志只保存标识哈希；生产环境应使用独立随机盐
PRUDENCE_AUDIT_SALT=replace-with-random-value

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs
